TELEGRAM_BOT_TOKEN=

# Optional: Google Flights results via SerpApi.
SERPAPI_API_KEY=
SERPAPI_GL=br
SERPAPI_HL=pt-br

# Optional: cached/tendency flight prices via Travelpayouts.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# Runtime
CHECK_INTERVAL_MINUTES=30
DEFAULT_CURRENCY=BRL
DATA_FILE=./data/monitor-aereo.json
DATABASE_URL=./data/monitor-aereo.sqlite
STORAGE_DRIVER=sqlite
MOCK_PROVIDER_ENABLED=true
